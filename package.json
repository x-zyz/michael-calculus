{
  "name": "michael-calculus",
  "private": true,
  "version": "1.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "check:css": "node scripts/check-css.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "android:sync": "npm run build && cap sync android",
    "android:debug": "npm run android:sync && cd android && ./gradlew assembleDebug",
    "android:release": "npm run android:sync && cd android && ./gradlew assembleRelease",
    "android:open": "cap open android",
    "test:signing": "node --test scripts/android-signing.test.mjs scripts/legacy-backup.test.mjs",
    "verify:apk": "node scripts/verify-android-release.mjs"
  },
  "dependencies": {
    "@capacitor/android": "7.6.10",
    "@capacitor/core": "7.6.10",
    "@tailwindcss/vite": "4.1.18",
    "katex": "0.16.22",
    "lucide-react": "0.468.0",
    "mathlive": "0.111.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-router-dom": "7.18.6",
    "tailwindcss": "4.1.18"
  },
  "devDependencies": {
    "@capacitor/cli": "7.6.10",
    "@eslint/js": "9.39.1",
    "@playwright/test": "1.58.2",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.0",
    "@types/katex": "0.16.7",
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.2",
    "eslint": "9.39.1",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-refresh": "0.4.24",
    "globals": "16.5.0",
    "jsdom": "27.4.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.50.0",
    "vite": "7.3.8",
    "vitest": "4.0.18"
  }
}
